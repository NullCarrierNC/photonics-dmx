            "type": "logic",
            "logicType": "expression",
            "expression": "60 + cellIdx",
            "assignTo": "haloLayGreen"
          },
          {
            "id": "rb3-glow-blue-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mBlue / pow(2, ledIdx)) % 2",
            "assignTo": "bitBlue"
          },
          {
            "id": "rb3-glow-blue-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "blue"]
            },
            "index": {
              "source": "variable",
              "name": "bitBlue"
