            "expression": "max(floor(mGreen / pow(2, wrap(cellIdx - 1, 8))) % 2, floor(mGreen / pow(2, wrap(cellIdx + 1, 8))) % 2) * (1 - bitGreen)",
            "assignTo": "haloGreen"
          },
