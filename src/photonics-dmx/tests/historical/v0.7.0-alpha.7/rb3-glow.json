        "notes": [
          {
            "id": "rb3-glow-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "Stage Kit plus a halo",
            "style": "notes",
            "note": "Every lit LED spills a low glow onto its two ring neighbours in the same bank colour. A chase becomes a bright head inside a travelling glow, and an alternating pattern fills its own gaps so the row reads as a colour bed with bright peaks."
          },
          {
            "id": "rb3-glow-note-2",
            "type": "notes",
            "label": "Notes",
            "title": "Neighbours wrap the ring",
            "style": "notes",
            "note": "Neighbours are found on the ring, not the row, so the cell before ring cell 0 is cell 7. With the rig wired so the ring counts round linearly, the glow travels continuously from the front row onto the back row and back again. A cell that is itself lit never takes a halo, so the real LED always stays the brightest thing on that light."
          },
          {
            "id": "rb3-glow-note-3",
            "type": "notes",
            "label": "Notes",
            "title": "Layers",
            "style": "notes",
            "note": "Black floor on layer 0, per-bank lights on the 10/20/30/40 bands plus the ring cell at 'medium', and the glow on the 50/60/70/80 bands plus the ring cell at 'low'. Everything blends with 'add', so two banks glowing onto the same neighbour mix exactly as their lights would."
          }
        ]
