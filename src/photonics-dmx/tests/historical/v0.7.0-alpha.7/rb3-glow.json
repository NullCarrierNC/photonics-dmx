          {
            "id": "rb3-glow-each",
            "type": "logic",
            "logicType": "for-each-light",
            "sourceVariable": "ringLights",
            "currentLightVariable": "curCell",
            "currentIndexVariable": "j"
          },
          {
            "id": "rb3-glow-jg",
            "type": "logic",
            "logicType": "expression",
            "expression": "j / ringGroupSize",
            "assignTo": "jg"
          },
          {
            "id": "rb3-glow-cell",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "cellIdx"
          },
          {
            "id": "rb3-glow-led",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "ledIdx"
          },
          {
            "id": "rb3-glow-red-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, ledIdx)) % 2",
            "assignTo": "bitRed"
          },
          {
            "id": "rb3-glow-red-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "red"]
            },
            "index": {
              "source": "variable",
              "name": "bitRed"
            },
            "assignTo": "colRed"
          },
          {
            "id": "rb3-glow-red-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "10 + cellIdx",
            "assignTo": "layRed"
          },
          {
            "id": "rb3-glow-red-halo",
            "type": "logic",
            "logicType": "expression",
            "expression": "max(floor(mRed / pow(2, wrap(cellIdx - 1, 8))) % 2, floor(mRed / pow(2, wrap(cellIdx + 1, 8))) % 2) * (1 - bitRed)",
            "assignTo": "haloRed"
          },
          {
            "id": "rb3-glow-red-halo-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "red"]
            },
            "index": {
              "source": "variable",
              "name": "haloRed"
            },
            "assignTo": "haloColRed"
          },
          {
            "id": "rb3-glow-red-halo-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "50 + cellIdx",
            "assignTo": "haloLayRed"
          },
          {
            "id": "rb3-glow-green-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mGreen / pow(2, ledIdx)) % 2",
            "assignTo": "bitGreen"
          },
          {
            "id": "rb3-glow-green-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "green"]
            },
            "index": {
              "source": "variable",
              "name": "bitGreen"
            },
            "assignTo": "colGreen"
          },
          {
            "id": "rb3-glow-green-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "20 + cellIdx",
            "assignTo": "layGreen"
          },
          {
