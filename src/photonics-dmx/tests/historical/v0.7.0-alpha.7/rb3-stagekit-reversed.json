            "assignTo": "colBlue"
          },
          {
            "id": "rb3-skrev-blue-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "30 + cellIdx",
            "assignTo": "layBlue"
          },
          {
            "id": "rb3-skrev-yellow-bit",
            "type": "logic",
