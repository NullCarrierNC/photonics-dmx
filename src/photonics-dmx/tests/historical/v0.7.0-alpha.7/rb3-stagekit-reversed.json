            },
            "index": {
              "source": "variable",
              "name": "bitRed"
            },
            "assignTo": "colRed"
          },
          {
            "id": "rb3-skrev-red-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "10 + cellIdx",
            "assignTo": "layRed"
          },
          {
            "id": "rb3-skrev-green-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mGreen / pow(2, ledIdx)) % 2",
