          },
          {
            "id": "rb3-skrev-green-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "green"]
            },
            "index": {
              "source": "variable",
              "name": "bitGreen"
            },
            "assignTo": "colGreen"
          },
          {
            "id": "rb3-skrev-green-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "20 + cellIdx",
            "assignTo": "layGreen"
          },
          {
            "id": "rb3-skrev-blue-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mBlue / pow(2, ledIdx)) % 2",
            "assignTo": "bitBlue"
          },
          {
            "id": "rb3-skrev-blue-col",
