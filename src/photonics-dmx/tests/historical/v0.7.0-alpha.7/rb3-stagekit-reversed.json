              "name": "jg"
            },
            "assignTo": "ledIdx"
          },
          {
            "id": "rb3-skrev-red-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, ledIdx)) % 2",
            "assignTo": "bitRed"
          },
          {
            "id": "rb3-skrev-red-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
