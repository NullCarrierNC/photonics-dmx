        "notes": [
          {
            "id": "rb3-comet-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "Stage Kit with a tail",
            "style": "notes",
            "note": "Stage Kit, but lights fade out rather than turning off immediately.\nChases leave a trail."
          },
          {
            "id": "rb3-comet-note-2",
            "type": "notes",
            "label": "Notes",
            "title": "How the tail is timed",
            "style": "notes",
            "note": "Each bank keeps one indexed-variable slot per light, holding the time that light was last seen lit, stamped from time-since-cue-start (plus 1, so a stored 0 means the cell has never been lit and must stay dark). The opacity is 1 while lit, otherwise the square root of the remaining tail fraction, which evens out the fall because blend 'add' scales the DMX value linearly with opacity."
          },
          {
            "id": "rb3-comet-note-3",
            "type": "notes",
            "label": "Notes",
            "title": "Layers",
            "style": "notes",
            "note": "Black floor on layer 0 and per-bank cells on the 10/20/30/40 bands plus the ring cell, all blending with 'add'. An opacity of 0 under 'add' contributes nothing, so a faded cell passes straight through to the floor."
          }
        ]
      },
