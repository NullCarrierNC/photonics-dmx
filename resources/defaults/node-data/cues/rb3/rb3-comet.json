            "dataProperty": "time-since-cue-start",
            "assignTo": "nowMs"
          },
          {
            "id": "rb3-comet-clock",
            "type": "logic",
            "logicType": "expression",
            "expression": "nowMs + 1",
            "assignTo": "t"
          },
          {
            "id": "rb3-comet-each",
            "type": "logic",
            "logicType": "for-each-light",
            "sourceVariable": "ringLights",
            "currentLightVariable": "curCell",
            "currentIndexVariable": "j"
          },
          {
            "id": "rb3-comet-jg",
            "type": "logic",
            "logicType": "expression",
            "expression": "j / ringGroupSize",
            "assignTo": "jg"
          },
          {
            "id": "rb3-comet-cell",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "cellIdx"
          },
          {
            "id": "rb3-comet-led",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "ledIdx"
          },
          {
            "id": "rb3-comet-red-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, cellIdx)) % 2",
            "assignTo": "bitRed"
          },
          {
            "id": "rb3-comet-red-last",
            "type": "logic",
            "logicType": "indexed-variable",
            "mode": "get",
            "varName": "lastRed",
            "index": {
              "source": "variable",
              "name": "cellIdx"
            },
            "valueType": "number",
            "assignTo": "prevRed"
          },
          {
            "id": "rb3-comet-red-stamp",
            "type": "logic",
            "logicType": "expression",
            "expression": "bitRed * t + (1 - bitRed) * prevRed",
            "assignTo": "stampRed"
          },
          {
            "id": "rb3-comet-red-store",
            "type": "logic",
            "logicType": "indexed-variable",
            "mode": "set",
            "varName": "lastRed",
            "index": {
              "source": "variable",
              "name": "cellIdx"
            },
            "valueType": "number",
            "value": {
              "source": "variable",
              "name": "stampRed"
            }
          },
          {
            "id": "rb3-comet-red-op",
            "type": "logic",
            "logicType": "expression",
            "expression": "bitRed + (1 - bitRed) * clamp(stampRed, 0, 1) * sqrt(clamp(1 - (t - stampRed) / 350, 0, 1))",
            "assignTo": "opRed"
          },
          {
            "id": "rb3-comet-red-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "10 + cellIdx",
            "assignTo": "layRed"
          },
          {
            "id": "rb3-comet-green-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mGreen / pow(2, cellIdx)) % 2",
            "assignTo": "bitGreen"
          },
          {
            "id": "rb3-comet-green-last",
            "type": "logic",
            "logicType": "indexed-variable",
            "mode": "get",
            "varName": "lastGreen",
            "index": {
              "source": "variable",
              "name": "cellIdx"
            },
            "valueType": "number",
            "assignTo": "prevGreen"
          },
          {
