        "notes": [
          {
            "id": "rb3-mirror-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "Front data on both rows",
            "style": "notes",
            "note": "Similar to Stage Kit, the difference is the LED map: ring cells 0-3 (the front row) show LEDs 1-4, and cells 4-7 (the back row) repeat their mirrored front partner rather than showing LEDs 5-8, so the back row always matches the light in front of it. The rear LED data is ignored."
          },
          {
            "id": "rb3-mirror-note-3",
            "type": "notes",
            "label": "Notes",
            "title": "Per-bank additive layers",
            "style": "notes",
            "note": "Each bank paints on its own layer band (red 10, green 20, blue 30, yellow 40, plus the ring cell) with blend 'add', so overlapping banks composite additively exactly like the direct processor. An unlit cell paints 'transparent' and passes through to the black floor on layer 0. The set-colors are non-blocking with a 50ms hold so a cell survives between calls."
          }
        ]
