            "assignTo": "mYellow"
          },
          {
            "id": "rb3-mirror-each",
            "type": "logic",
            "logicType": "for-each-light",
            "sourceVariable": "ringLights",
            "currentLightVariable": "curCell",
            "currentIndexVariable": "j"
          },
          {
            "id": "rb3-mirror-jg",
            "type": "logic",
            "logicType": "expression",
            "expression": "j / ringGroupSize",
            "assignTo": "jg"
          },
          {
            "id": "rb3-mirror-cell",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "cellIdx"
          },
          {
            "id": "rb3-mirror-led",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 3, 2, 1, 0],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "ledIdx"
          },
          {
            "id": "rb3-mirror-red-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, ledIdx)) % 2",
            "assignTo": "bitRed"
          },
          {
            "id": "rb3-mirror-red-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "red"]
            },
            "index": {
              "source": "variable",
              "name": "bitRed"
            },
            "assignTo": "colRed"
          },
          {
            "id": "rb3-mirror-red-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "10 + cellIdx",
            "assignTo": "layRed"
          },
          {
            "id": "rb3-mirror-green-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mGreen / pow(2, ledIdx)) % 2",
            "assignTo": "bitGreen"
          },
          {
            "id": "rb3-mirror-green-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "green"]
            },
            "index": {
              "source": "variable",
              "name": "bitGreen"
            },
            "assignTo": "colGreen"
          },
          {
            "id": "rb3-mirror-green-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "20 + cellIdx",
            "assignTo": "layGreen"
          },
          {
            "id": "rb3-mirror-blue-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mBlue / pow(2, ledIdx)) % 2",
            "assignTo": "bitBlue"
          },
          {
            "id": "rb3-mirror-blue-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "blue"]
            },
            "index": {
              "source": "variable",
              "name": "bitBlue"
            },
            "assignTo": "colBlue"
          },
          {
            "id": "rb3-mirror-blue-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "30 + cellIdx",
            "assignTo": "layBlue"
          },
          {
            "id": "rb3-mirror-yellow-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mYellow / pow(2, ledIdx)) % 2",
            "assignTo": "bitYellow"
          },
          {
            "id": "rb3-mirror-yellow-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "yellow"]
            },
            "index": {
              "source": "variable",
              "name": "bitYellow"
            },
            "assignTo": "colYellow"
          },
          {
            "id": "rb3-mirror-yellow-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "40 + cellIdx",
            "assignTo": "layYellow"
          }
        ],
        "eventRaisers": [],
