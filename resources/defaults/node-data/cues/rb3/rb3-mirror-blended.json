            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "green"]
            },
            "index": {
              "source": "variable",
              "name": "overGreen"
            },
            "assignTo": "overColGreen"
          },
          {
            "id": "rb3-mirrorb-green-over-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "60 + cellIdx",
            "assignTo": "overLayGreen"
          },
          {
            "id": "rb3-mirrorb-blue-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mBlue / pow(2, ledIdx)) % 2",
            "assignTo": "bitBlue"
          },
          {
            "id": "rb3-mirrorb-blue-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "blue"]
            },
            "index": {
              "source": "variable",
              "name": "bitBlue"
            },
            "assignTo": "colBlue"
          },
          {
            "id": "rb3-mirrorb-blue-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "30 + cellIdx",
            "assignTo": "layBlue"
          },
          {
            "id": "rb3-mirrorb-blue-over-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mBlue / pow(2, 7 - cellIdx)) % 2 * clamp(4 - cellIdx, 0, 1)",
            "assignTo": "overBlue"
          },
