        "logic": [
          {
            "id": "rb3-mirrorb-ring",
            "type": "logic",
            "logicType": "build-ring",
            "assignTo": "ringLights",
            "assignGroupSize": "ringGroupSize"
          },
          {
            "id": "rb3-mirrorb-cd-red",
            "type": "logic",
            "logicType": "cue-data",
            "dataProperty": "led-red-states",
            "assignTo": "mRed"
          },
          {
            "id": "rb3-mirrorb-cd-green",
            "type": "logic",
            "logicType": "cue-data",
            "dataProperty": "led-green-states",
