            "assignTo": "mYellow"
          },
          {
            "id": "rb3-mirrorb-each",
            "type": "logic",
            "logicType": "for-each-light",
            "sourceVariable": "ringLights",
            "currentLightVariable": "curCell",
            "currentIndexVariable": "j"
          },
          {
            "id": "rb3-mirrorb-jg",
            "type": "logic",
            "logicType": "expression",
            "expression": "j / ringGroupSize",
            "assignTo": "jg"
          },
          {
            "id": "rb3-mirrorb-cell",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 4, 5, 6, 7],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "cellIdx"
          },
          {
            "id": "rb3-mirrorb-led",
            "type": "logic",
            "logicType": "select-from-list",
            "list": [0, 1, 2, 3, 3, 2, 1, 0],
            "index": {
              "source": "variable",
              "name": "jg"
            },
            "assignTo": "ledIdx"
          },
          {
            "id": "rb3-mirrorb-red-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, ledIdx)) % 2",
            "assignTo": "bitRed"
          },
          {
            "id": "rb3-mirrorb-red-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "red"]
            },
            "index": {
              "source": "variable",
              "name": "bitRed"
            },
            "assignTo": "colRed"
          },
          {
            "id": "rb3-mirrorb-red-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "10 + cellIdx",
            "assignTo": "layRed"
          },
          {
            "id": "rb3-mirrorb-red-over-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mRed / pow(2, 7 - cellIdx)) % 2 * clamp(4 - cellIdx, 0, 1)",
            "assignTo": "overRed"
          },
          {
            "id": "rb3-mirrorb-red-over-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "red"]
            },
            "index": {
              "source": "variable",
              "name": "overRed"
            },
            "assignTo": "overColRed"
          },
          {
            "id": "rb3-mirrorb-red-over-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "50 + cellIdx",
            "assignTo": "overLayRed"
          },
          {
            "id": "rb3-mirrorb-green-bit",
            "type": "logic",
            "logicType": "expression",
            "expression": "floor(mGreen / pow(2, ledIdx)) % 2",
            "assignTo": "bitGreen"
          },
          {
            "id": "rb3-mirrorb-green-col",
            "type": "logic",
            "logicType": "color-from-index",
            "colors": {
              "source": "literal",
              "value": ["transparent", "green"]
            },
            "index": {
              "source": "variable",
              "name": "bitGreen"
            },
            "assignTo": "colGreen"
          },
          {
            "id": "rb3-mirrorb-green-lay",
            "type": "logic",
            "logicType": "expression",
            "expression": "20 + cellIdx",
            "assignTo": "layGreen"
          },
          {
            "id": "rb3-mirrorb-green-over-bit",
            "type": "logic",
