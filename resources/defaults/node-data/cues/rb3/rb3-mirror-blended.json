        "eventRaisers": [],
        "eventListeners": [],
        "effectRaisers": [],
        "notes": [
          {
            "id": "rb3-mirrorb-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "Mirror plus the rear data",
            "style": "notes",
            "note": "The base layer is the Mirror look: ring cells 0-3 (the front row) show LEDs 1-4 and cells 4-7 (the back row) repeat their mirrored front partner. On top of that, each FRONT light also receives its partner's rear LED with blend 'add', so front light 1 carries LED 1 plus LED 8, front light 2 carries LED 2 plus LED 7, and so on."
          },
          {
            "id": "rb3-mirrorb-note-3",
            "type": "notes",
            "label": "Notes",
            "title": "Layer bands",
            "style": "notes",
            "note": "Mirror lights draw on the low per-bank bands (red 10, green 20, blue 30, yellow 40, plus the ring cell) and the rear overlay draws higher (red 50, green 60, blue 70, yellow 80, plus the ring cell), all with blend 'add' over the black floor on layer 0."
          }
        ]
      },
      "connections": [
