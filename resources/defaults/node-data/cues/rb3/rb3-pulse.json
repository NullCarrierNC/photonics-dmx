          {
            "id": "rb3-pulse-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "Pulse meter",
            "style": "notes",
            "note": "Interprets the RB3 game as one VU-style bed rather than mirroring the StageKit. The whole rig fades to led-color with a brightness that tracks led-count (0 lit = off, 8 = full) on every cue-called keepalive. Bed level rides color.opacity because set-color intensity is otherwise a fixed brightness enum."
          },
          {
            "id": "rb3-pulse-note-2",
            "type": "notes",
            "label": "Notes",
            "title": "LED-edge sparkle",
            "style": "notes",
            "note": "Each led-1..led-8 on-edge fires one white flash impulse on layer 101, so busy passages read as sparkle over the bed. Strobes are the classic full-rig white."
          }
        ]
