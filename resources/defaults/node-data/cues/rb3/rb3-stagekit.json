        "notes": [
          {
            "id": "rb3-base-note-1",
            "type": "notes",
            "label": "Notes",
            "title": "StageKit mirror",
            "style": "notes",
            "note": "Re-renders the four RB3 LED bank masks (red/green/blue/yellow) onto the rig every cue-called keepalive. build-ring folds the rig to a virtual 8-step ring (4 lights -> LED i on light i&3, 8 -> 1:1, 16 -> interleaved), matching the direct StageKit processor."
          },
          {
            "id": "rb3-base-note-2",
            "type": "notes",
            "label": "Notes",
            "title": "Per-bank additive layers",
            "style": "notes",
            "note": "Each bank paints on its own low layer band (red 10+, green 20+, blue 30+, yellow 40+; +ring index) with blend 'add', so overlapping banks composite additively like the direct processor. An unlit cell paints 'transparent' (passes through). The set-colors are non-blocking with a 50ms hold so a layer>0 cell survives between cue-called."
          }
        ]
